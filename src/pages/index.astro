---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import site from "../../site.config.mjs";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title={site.name}>
  <div class="hero">
    <h1>{site.name}</h1>
    <p class="tagline">{site.tagline}</p>
    <p class="lede">
      Practical notes on content operations, retrieval, and search for teams that
      publish where customers buy. Written by the {site.author}.
    </p>
  </div>

  <h2 class="section-title">Latest posts</h2>

  <div class="post-grid">
    {posts.map((post) => (
      <a class="post-card" href={`/blog/${post.slug}/`}>
        <h2>{post.data.title}</h2>
        <p class="excerpt">{post.data.description}</p>
        <div class="meta">
          <span>
            {post.data.pubDate.toLocaleDateString("en-US", {
              year: "numeric",
              month: "short",
              day: "numeric",
            })}
          </span>
          <span>{post.data.category}</span>
        </div>
        <div class="tag-list">
          {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
        </div>
      </a>
    ))}
  </div>
</Layout>
